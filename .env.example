APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000


GEMINI_API_KEY="asdsda"

DOCUMENT_AI_ENABLED=true
DOCUMENT_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
DOCUMENT_AI_API_KEY=tu_api_key
DOCUMENT_AI_MODEL=gemini-3.8-flash
DOCUMENT_AI_TIMEOUT=60
DOCUMENT_AI_MAX_DIMENSION=1000
DOCUMENT_AI_MIN_REJECT_CONFIDENCE=0.7

# Para migrar a OpenRouter, solo cambia estas líneas:
# DOCUMENT_AI_BASE_URL=https://openrouter.ai/api/v1
# DOCUMENT_AI_API_KEY=sk-or-...
# DOCUMENT_AI_MODEL=google/<modelo-gemini>
# DOCUMENT_AI_REFERER=https://tu-dominio.mx
# DOCUMENT_AI_APP_TITLE="SIUT ITSM"

# Cola (obligatorio en hosting compartido; "sync" bloquearía la petición)
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180


APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ost_siut_itsm_laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

MAIL_ADMIN_ADDRESS="admin@example.com"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


ADMIN_CURP=
